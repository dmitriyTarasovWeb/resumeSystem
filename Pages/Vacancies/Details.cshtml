@page "/Vacancies/Details/{id:guid}"
@model resumeSystem.Pages.Vacancies.DetailsModel

@{
    ViewData["Title"] = Model.Vacancy.Title;
}

<div class="container py-4 pb-5">

        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

        <div>

            <h1 class="h2 mb-2">
                @Model.Vacancy.Title
            </h1>

            <div class="fs-5 text-body-secondary">
                @Model.Vacancy.PositionName
            </div>

        </div>

        <div class="d-flex gap-2 flex-wrap">

            @if (Model.CanApply)
            {
                <form method="post"
                      asp-page-handler="Apply">

                    <input type="hidden"
                           name="id"
                           value="@Model.Vacancy.Id" />

                    <button type="submit"
                            class="btn btn-success"
                            @(Model.HasApplied ? "disabled" : null)>
                        @(Model.HasApplied
                            ? "Отклик отправлен"
                            : "Откликнуться")
                    </button>

                </form>
            }

            @if (Model.CanEdit)
            {
                <a asp-page="/Vacancies/Create"
                   asp-route-id="@Model.Vacancy.Id"
                   class="btn btn-primary">
                    Редактировать
                </a>

                <form method="post"
                      asp-page-handler="Delete"
                      onsubmit="return confirm('Удалить эту вакансию?');">

                    <input type="hidden"
                           name="id"
                           value="@Model.Vacancy.Id" />

                    <button type="submit"
                            class="btn btn-danger">
                        Удалить
                    </button>

                </form>



            }

        </div>

    </div>


    <div class="border rounded bg-body mb-4">
        <div class="border-bottom px-3 px-md-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">API access</h5>
                    <div class="text-body-secondary">
                        Use this token to import aggregated position results into Odoo.
                    </div>
                </div>

                <button type="button"
                        id="getApiTokenButton"
                        class="btn btn-outline-primary">
                    Get API token
                </button>
            </div>

            <div id="apiTokenLoading"
                 class="d-none mt-3 text-body-secondary">
                Loading...
            </div>

            <div id="apiTokenResult"
                 class="d-none mt-3">
                <label for="apiTokenInput" class="form-label">
                    API token
                </label>

                <div class="input-group">
                    <input type="text"
                           id="apiTokenInput"
                           class="form-control"
                           readonly>

                    <button type="button"
                            id="copyApiTokenButton"
                            class="btn btn-outline-secondary">
                        Copy
                    </button>
                </div>
            </div>

            <div id="apiTokenError"
                 class="d-none mt-3 text-danger">
            </div>
        </div>
    </div>


    <section class="border rounded bg-body mb-4">

        <div class="border-bottom px-3 px-md-4 py-3">

            <h2 class="h6 mb-0 fw-semibold">
                Описание
            </h2>

        </div>

        <div class="p-3 p-md-4">

            @if (!string.IsNullOrWhiteSpace(Model.Vacancy.Description))
            {
                <div class="vacancy-description">
                    @Html.Raw(
                        Markdig.Markdown.ToHtml(
                            Model.Vacancy.Description
                        )
                    )
                </div>
            }
            else
            {
                <div class="text-body-secondary">
                    Описание отсутствует.
                </div>
            }

        </div>

    </section>


    <section class="border rounded bg-body mb-4">

        <div class="border-bottom px-3 px-md-4 py-3">

            <h2 class="h6 mb-0 fw-semibold">
                Атрибуты
            </h2>

        </div>

        <div class="p-3 p-md-4">

            @if (Model.Attributes.Count == 0)
            {
                <div class="text-body-secondary">
                    Атрибуты не указаны.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-sm align-middle mb-0">


                        <tbody>

                            @foreach (var attr in Model.Attributes)
                            {
                                <tr>

                                    <td class="fw-medium">
                                        @attr.Title
                                    </td>

                                    <td>
                                        @switch (attr.Value)
                                        {
                                            case "true":
                                                @:Да
                                                break;

                                            case "false":
                                                @:Нет
                                                break;

                                            default:
                                                @attr.Value
                                                break;
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </section>


    <section class="border rounded bg-body mb-4">

        <div class="border-bottom px-3 px-md-4 py-3">

            <h2 class="h6 mb-0 fw-semibold">
                Теги
            </h2>

        </div>

        <div class="p-3 px-md-4 py-3">

            @if (Model.Tags.Count == 0)
            {
                <span class="text-body-secondary">
                    Теги не указаны.
                </span>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">

                    @foreach (var tag in Model.Tags)
                    {
                        <span class="badge text-bg-secondary">
                            @tag
                        </span>
                    }

                </div>
            }

        </div>

    </section>

    @if (Model.CanEdit)
    {
        <section class="border rounded bg-body mb-4">

            <div class="border-bottom px-3 px-md-4 py-3">
                <h2 class="h6 mb-0 fw-semibold">
                    Отклики
                </h2>
            </div>

            <div class="p-3 p-md-4">

                <div class="table-responsive">

                    <table id="applications-table"
                           class="table table-striped table-hover align-middle w-100"
                           style="table-layout: fixed;">

                        <thead>
                            <tr>
                                <th class="text-start">Кандидат</th>
                                <th class="text-start">Дата отклика</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var application in Model.Applications)
                            {
                                <tr>
                                    <td class="text-start fw-semibold">
                                        <a asp-page="/Resumes/Create"
                                           asp-route-vacancyId="@Model.Vacancy.Id"
                                           asp-route-resumeId="@application.ResumeId"
                                           class="text-decoration-none">
                                            @application.FirstName @application.LastName
                                        </a>
                                    </td>

                                    <td class="text-start">
                                        @application.ApplyTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

            </div>
        </section>
    }

    <div>

        <a asp-page="/Index"
           class="btn btn-outline-secondary">
            Назад к вакансиям
        </a>

    </div>

</div>

@section Scripts {
    <script>
        window.positionId = @Model.Vacancy.PositionId
    </script>
    <script src="~/js/position-api-token.js"></script>

    <script>
        const applicationsTable = document.getElementById("applications-table")

        if (applicationsTable) {

            new DataTable(applicationsTable, {
                autoWidth: false,
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, "Все"]
                ],

                order: [[1, "desc"]]
            })
        }
    </script>

    


}