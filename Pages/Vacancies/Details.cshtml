@page "/Vacancies/Details/{id:guid}"
@model resumeSystem.Pages.Vacancies.DetailsModel

@{
    ViewData["Title"] = Model.Vacancy.Title;
}

<div class="container py-4 pb-5">

        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

        <div>

            <h1 class="h2 mb-2">
                @Model.Vacancy.Title
            </h1>

            <div class="fs-5 text-body-secondary">
                @Model.Vacancy.PositionName
            </div>

        </div>

        <div class="d-flex gap-2 flex-wrap">

            @if (Model.CanApply)
            {
                <form method="post"
                      asp-page-handler="Apply">

                    <input type="hidden"
                           name="id"
                           value="@Model.Vacancy.Id" />

                    <button type="submit"
                            class="btn btn-success"
                            @(Model.HasApplied ? "disabled" : null)>
                        @(Model.HasApplied
                            ? "Отклик отправлен"
                            : "Откликнуться")
                    </button>

                </form>
            }

            @if (Model.CanEdit)
            {
                <a asp-page="/Vacancies/Create"
                   asp-route-id="@Model.Vacancy.Id"
                   class="btn btn-primary">
                    Редактировать
                </a>

                <form method="post"
                      asp-page-handler="Delete"
                      onsubmit="return confirm('Удалить эту вакансию?');">

                    <input type="hidden"
                           name="id"
                           value="@Model.Vacancy.Id" />

                    <button type="submit"
                            class="btn btn-danger">
                        Удалить
                    </button>

                </form>



            }

        </div>

    </div>

     @if (Model.CanEdit)
    {
        <div class="border rounded bg-body mb-4">
            <div class="border-bottom px-3 px-md-4 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">API key for Odoo</h5>
                    </div>

                    <button type="button" id="getApiTokenButton" class="btn btn-outline-primary">
                        Get API token
                    </button>
                </div>

                <div id="apiTokenLoading" class="d-none mt-3 text-body-secondary">
                    Loading...
                </div>

                <div id="apiTokenResult" class="d-none mt-3">
                    <label for="apiTokenInput" class="form-label">API token</label>

                    <div class="input-group">
                        <input type="password" id="apiTokenInput" class="form-control" readonly autocomplete="off">

                        <button type="button" id="toggleApiTokenButton" class="btn btn-outline-secondary" title="Show token" aria-label="Show token">
                            <svg id="eyeIcon" class="d-none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.06 12.35a1 1 0 0 1 0-.7C3.54 7.26 7.54 4 12 4c4.46 0 8.46 3.26 9.94 7.65a1 1 0 0 1 0 .7C20.46 16.74 16.46 20 12 20c-4.46 0-8.46-3.26-9.94-7.65z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg id="eyeOffIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18" /><path d="M10.58 10.58a2 2 0 0 0 2.83 2.83" /><path d="M9.88 4.24A9.93 9.93 0 0 1 12 4c4.46 0 8.46 3.26 9.94 7.65a1 1 0 0 1 0 .7c-.52 1.55-1.4 2.93-2.53 4.07" /><path d="M6.61 6.61C4.65 7.83 3.09 9.7 2.06 11.65a1 1 0 0 0 0 .7C3.54 16.74 7.54 20 12 20c1.61 0 3.15-.42 4.52-1.16" /></svg>
                        </button>

                        <button type="button" id="copyApiTokenButton" class="btn btn-outline-secondary">
                            Copy
                        </button>
                    </div>
                </div>

                <div id="apiTokenError" class="d-none mt-3 text-danger"></div>
            </div>
        </div>

    }

    <section class="border rounded bg-body mb-4">

        <div class="border-bottom px-3 px-md-4 py-3">

            <h2 class="h6 mb-0 fw-semibold">
                Описание
            </h2>

        </div>

        <div class="p-3 p-md-4">

            @if (!string.IsNullOrWhiteSpace(Model.Vacancy.Description))
            {
                <div class="vacancy-description">
                    @Html.Raw(
                        Markdig.Markdown.ToHtml(
                            Model.Vacancy.Description
                        )
                    )
                </div>
            }
            else
            {
                <div class="text-body-secondary">
                    Описание отсутствует.
                </div>
            }

        </div>

    </section>


    <section class="border rounded bg-body mb-4">

        <div class="border-bottom px-3 px-md-4 py-3">

            <h2 class="h6 mb-0 fw-semibold">
                Атрибуты
            </h2>

        </div>

        <div class="p-3 p-md-4">

            @if (Model.Attributes.Count == 0)
            {
                <div class="text-body-secondary">
                    Атрибуты не указаны.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-sm align-middle mb-0">


                        <tbody>

                            @foreach (var attr in Model.Attributes)
                            {
                                <tr>

                                    <td class="fw-medium">
                                        @attr.Title
                                    </td>

                                    <td>
                                        @switch (attr.Value)
                                        {
                                            case "true":
                                                @:Да
                                                break;

                                            case "false":
                                                @:Нет
                                                break;

                                            default:
                                                @attr.Value
                                                break;
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </section>


    <section class="border rounded bg-body mb-4">

        <div class="border-bottom px-3 px-md-4 py-3">

            <h2 class="h6 mb-0 fw-semibold">
                Теги
            </h2>

        </div>

        <div class="p-3 px-md-4 py-3">

            @if (Model.Tags.Count == 0)
            {
                <span class="text-body-secondary">
                    Теги не указаны.
                </span>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">

                    @foreach (var tag in Model.Tags)
                    {
                        <span class="badge text-bg-secondary">
                            @tag
                        </span>
                    }

                </div>
            }

        </div>

    </section>

    @if (Model.CanEdit)
    {
        <section class="border rounded bg-body mb-4">

            <div class="border-bottom px-3 px-md-4 py-3">
                <h2 class="h6 mb-0 fw-semibold">
                    Отклики
                </h2>
            </div>

            <div class="p-3 p-md-4">

                <div class="table-responsive">

                    <table id="applications-table"
                           class="table table-striped table-hover align-middle w-100"
                           style="table-layout: fixed;">

                        <thead>
                            <tr>
                                <th class="text-start">Кандидат</th>
                                <th class="text-start">Дата отклика</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var application in Model.Applications)
                            {
                                <tr>
                                    <td class="text-start fw-semibold">
                                        <a asp-page="/Resumes/Create"
                                           asp-route-vacancyId="@Model.Vacancy.Id"
                                           asp-route-resumeId="@application.ResumeId"
                                           class="text-decoration-none">
                                            @application.FirstName @application.LastName
                                        </a>
                                    </td>

                                    <td class="text-start">
                                        @application.ApplyTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

            </div>
        </section>
    }

    <div>

        <a asp-page="/Index"
           class="btn btn-outline-secondary">
            Назад к вакансиям
        </a>

    </div>

</div>

@section Scripts {
    <script>
        window.positionId = @Model.Vacancy.PositionId
    </script>
    <script src="~/js/position-api-token.js"></script>

    <script>
        const applicationsTable = document.getElementById("applications-table")

        if (applicationsTable) {

            new DataTable(applicationsTable, {
                autoWidth: false,
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, "Все"]
                ],

                order: [[1, "desc"]]
            })
        }


        toggleApiTokenButton.addEventListener('click', function () {
            const isHidden = apiTokenInput.type === 'password';

            apiTokenInput.type = isHidden ? 'text' : 'password';

            eyeIcon.classList.toggle('d-none', !isHidden);
            eyeOffIcon.classList.toggle('d-none', isHidden);

            toggleApiTokenButton.title = isHidden
                ? 'Hide token'
                : 'Show token';

            toggleApiTokenButton.setAttribute(
                'aria-label',
                isHidden ? 'Hide token' : 'Show token'
            );
        });
    </script>



    


}