@using Microsoft.AspNetCore.Identity
@using resumeSystem.Domain;
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - resumeSystem</title>
    <script>
        const savedTheme = localStorage.getItem("theme") || "light"
        document.documentElement.setAttribute("data-bs-theme",savedTheme)
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/resumeSystem.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-3.1.1/datatables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@yaireo/tagify/dist/tagify.css" />
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-xxl navbar-light bg-body border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand fw-semibold"
                   asp-area=""
                   asp-page="/Index">
                    resumeSystem
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-xxl-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-body-tertiary mt-auto">
        <div class="container py-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                @if (SignInManager.IsSignedIn(User))
                {

                    <a href="#"
                    class="text-decoration-none"
                    data-bs-toggle="modal"
                    data-bs-target="#supportTicketModal">
                        Обращение в службу поддержки
                    </a>                
                }
            </div>
        </div>
    </footer>

    <div class="modal fade" id="supportTicketModal" tabindex="-1" aria-labelledby="supportTicketModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page="/Support" asp-page-handler="Create">
                    <div class="modal-header">
                        <h5 class="modal-title" id="supportTicketModalLabel">
                            Create support ticket
                        </h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="supportSummary" class="form-label">Текст обращения:</label>
                            <textarea id="supportSummary"
                                      name="Summary"
                                      class="form-control"
                                      rows="4"
                                      required></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="supportPriority" class="form-label">Приоритет</label>
                            <select id="supportPriority"
                                    name="Priority"
                                    class="form-select"
                                    required>
                                <option value="High">Высокий</option>
                                <option value="Average" selected>Средний</option>
                                <option value="Low">Низкий</option>
                            </select>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Create ticket
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/tagify"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/lib/marked.umd.min.js"></script>
    <script src="https://cdn.datatables.net/v/bs5/dt-3.1.1/datatables.min.js"></script>
    <script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>