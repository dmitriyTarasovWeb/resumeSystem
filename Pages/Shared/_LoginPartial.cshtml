@using Microsoft.AspNetCore.Identity
@using resumeSystem.Domain;
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-lg-2">


@if (SignInManager.IsSignedIn(User))
{
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        @if (User.IsInRole("Administrator"))
        {
            <li class="nav-item">
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Users">
                    Управление пользователями
                </a>
            </li>
        }



        @if (User.IsInRole("Administrator") || User.IsInRole("Recruiter"))
        {
            <li class="nav-item">
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Resumes/Index">
                    Банк резюме
                </a>
            </li>

            <li class="nav-item">
                <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-page="/Vacancies/Create">
                    Создать вакансию
                </a>
            </li>

            <li class="nav-item">
                <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-page="/Attributes/Index">
                    Библиотека атрибутов
                </a>
            </li>
        }


        
    }

    <li class="nav-item">
        <a class="btn btn-outline-secondary btn-sm" href="/Profile">
            Профиль
        </a>
    </li>

    <li class="nav-item d-flex align-items-center">
        <a class="nav-link"
           asp-area="Identity"
           asp-page="/Account/Manage/Index"
           title="Manage">
            @User.Identity?.Name
        </a>

        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">

            <button type="submit" class="btn btn-outline-secondary btn-sm">
                Выйти
            </button>
        </form>
    </li>

}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">
            Регистрация
        </a>
    </li>

    <li class="nav-item">
        <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">
            Войти
        </a>
    </li>
}


    <li class="nav-item">
        <button type="button"
                id="theme-toggle"
                class="btn btn-outline-secondary btn-sm"
                title="Сменить тему">
            🌙
        </button>
    </li>
    
</ul>

<script>


    const themeToggle = document.getElementById("theme-toggle")

    if (themeToggle) {

        function updateTheme() {

            const theme =
                document.documentElement.getAttribute("data-bs-theme")

            themeToggle.textContent =
                theme === "dark" ? "☀️" : "🌙"
        }

        updateTheme()

        themeToggle.addEventListener("click", function () {

            const currentTheme =
                document.documentElement.getAttribute("data-bs-theme")

            const newTheme =
                currentTheme === "dark" ? "light" : "dark"

            document.documentElement.setAttribute(
                "data-bs-theme",
                newTheme
            )

            localStorage.setItem("theme", newTheme)

            updateTheme()
        })
    }
</script>