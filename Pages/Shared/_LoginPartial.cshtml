@using Microsoft.AspNetCore.Identity
@using resumeSystem.Domain;
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-lg-2">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        @if (User.IsInRole("Administrator"))
        {
            <li class="nav-item">
                <a class="btn btn-light btn-sm" asp-page="/Admin/Users">
                    Управление пользователями
                </a>
            </li>
        }



        @if (User.IsInRole("Administrator") || User.IsInRole("Recruiter"))
        {
            <li class="nav-item">
                <a class="btn btn-light btn-sm" asp-page="/Resumes/Index">
                    Банк резюме
                </a>
            </li>

            <li class="nav-item">
                <a class="btn btn-light btn-sm" asp-area="" asp-page="/Vacancies/Create">
                    Создать вакансию
                </a>
            </li>

            <li class="nav-item">
                <a class="btn btn-light btn-sm" asp-area="" asp-page="/Attributes/Index">
                    Библиотека атрибутов
                </a>
            </li>
        }


        
    }

    <li class="nav-item">
        <a class="btn btn-light btn-sm" href="/Profile">
            Профиль
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link fw-bold"
           asp-area="Identity"
           asp-page="/Account/Manage/Index"
           title="Manage">
            @User.Identity?.Name
        </a>
    </li>

    <li class="nav-item">
        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                Выйти
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">
            Регистрация
        </a>
    </li>

    <li class="nav-item">
        <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">
            Войти
        </a>
    </li>
}
</ul>