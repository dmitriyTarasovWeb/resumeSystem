@page "/Profile/{id?}"
@model resumeSystem.Pages.Profile.ProfileModel

@{
    ViewData["Title"] = "Профиль";
}

<h1>Профиль</h1>

<div class="row">
    <div class="col-md-6">

        @if (Model.CanEdit)
        {
            <form method="post"
                  enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label">
                        @Model.Role
                    </label>

                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Аватар
                    </label>


                    <span asp-validation-for="Avatar"
                          class="text-danger"></span>
                </div>


                <div class="mb-4">
                    <img src="@(Model.PhotoUrl ?? "https://abrakadabra.fun/uploads/posts/2021-12/thumbs/1640528661_1-abrakadabra-fun-p-serii-chelovek-na-avu-1.png")"
                         alt="Аватар"
                         width="150"
                         height="150"
                         class="rounded-circle object-fit-cover" />
                </div>


                <button type="button"
                        class="btn btn-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#avatarModal">
                    Изменить аватар
                </button>

                <div class="mb-3">
                    <label asp-for="Input.FirstName" class="form-label">
                        Имя
                    </label>

                    <input asp-for="Input.FirstName"
                           class="form-control" />

                    <span asp-validation-for="Input.FirstName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.LastName" class="form-label">
                        Фамилия
                    </label>

                    <input asp-for="Input.LastName"
                           class="form-control" />

                    <span asp-validation-for="Input.LastName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Age" class="form-label">
                        Возраст
                    </label>

                    <input asp-for="Input.Age"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="Input.Age"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Location" class="form-label">
                        Местоположение
                    </label>

                    <input asp-for="Input.Location"
                           class="form-control" />

                    <span asp-validation-for="Input.Location"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label">
                        О себе
                    </label>

                    <textarea asp-for="Input.Description"
                              class="form-control"
                              rows="5"></textarea>

                    <span asp-validation-for="Input.Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">
                        Email
                    </label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           readonly />
                </div>

                <div class="card card-primary card-outline mb-4">
                    <div class="card-header">
                        <h3 class="card-title">Дополнительная информация</h3>
                    </div>
                    <div class="card-body">

                        <div id="attributes-container">
                        </div>

                        @if (Model.CanEdit)
                        {
                            <button type="button" class="btn btn-outline-primary mt-3" data-bs-toggle="modal" data-bs-target="#addAttributeModal">
                                <i class="bi bi-plus-circle"></i> Добавить атрибут
                            </button>
                        }

                    </div>
                </div>

                <div class="card card-primary card-outline mb-4">
                    <div class="card-header">
                        <h3 class="card-title">Проекты / Опыт работы</h3>
                    </div>
                    <div class="card-body">
                        <div id="experiences-list-container"></div>
                        <div id="experiences-hidden-inputs"></div>

                        @if (Model.CanEdit)
                        {
                            <button type="button" class="btn btn-outline-primary mt-2" id="btn-add-experience">
                                <i class="bi bi-plus-circle"></i> Добавить проект
                            </button>
                        }
                    </div>
                </div>



                <button type="submit" class="btn btn-primary">
                    Сохранить
                </button>
            </form>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">
                    Имя
                </label>

                <div class="form-control-plaintext">
                    @Model.Input.FirstName
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Фамилия
                </label>

                <div class="form-control-plaintext">
                    @Model.Input.LastName
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Возраст
                </label>

                <div class="form-control-plaintext">
                    @(Model.Input.Age?.ToString() ?? "Не указан")
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Местоположение
                </label>

                <div class="form-control-plaintext">
                    @(Model.Input.Location ?? "Не указано")
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    О себе
                </label>

                <div class="form-control-plaintext">
                    @(Model.Input.Description ?? "Не указано")
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Email
                </label>

                <div class="form-control-plaintext">
                    @Model.Input.Email
                </div>
            </div>
        }

    </div>
</div>

@if (Model.CanEdit)
{
    <div class="modal fade"
         id="avatarModal"
         tabindex="-1"
         aria-labelledby="avatarModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="avatarModalLabel">
                        Изменить аватар
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Закрыть">
                    </button>
                </div>

                <div class="modal-body">

                    <form method="post"
                          enctype="multipart/form-data"
                          id="avatarForm">

                        <div id="avatarDropZone"
                             class="border rounded p-5 text-center">

                            <div class="mb-3">
                                Перетащите фото сюда
                            </div>

                            <div class="text-muted mb-3">
                                или
                            </div>

                            <label for="avatarInput"
                                   class="btn btn-outline-primary">
                                Выберите в проводнике
                            </label>

                            <input id="avatarInput"
                                   name="Avatar"
                                   type="file"
                                   accept="image/jpeg,image/png,image/webp"
                                   class="d-none" />

                        </div>

                        <div id="avatarPreviewContainer"
                             class="text-center mt-4 d-none">

                            <img id="avatarPreview"
                                 src=""
                                 alt="Предпросмотр"
                                 width="150"
                                 height="150"
                                 class="rounded-circle object-fit-cover" />

                        </div>

                        <div class="mt-4 d-flex justify-content-end gap-2">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Отмена
                            </button>

                            <button type="submit"
                                    asp-page-handler="UploadAvatar"
                                    class="btn btn-primary">
                                Загрузить
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
}

@if (Model.CanEdit)
{
    <div class="modal fade" id="addAttributeModal" tabindex="-1" aria-labelledby="addAttributeModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addAttributeModalLabel">Выбор атрибута</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Категория</label>
                        <select id="category-select" class="form-select">
                            <option value="">-- Выберите категорию --</option>
                            @foreach (var cat in Model.AvailableCategories)
                            {
                                <option value="@cat.Id">@cat.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Атрибут</label>
                        <select id="attribute-select" class="form-select">
                            <option value="">-- Выберите атрибут --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="button" class="btn btn-primary" id="btn-confirm-add-attribute" disabled>Добавить на страницу</button>
                </div>
            </div>
        </div>
    </div>

    @if (Model.CanEdit)
    {
        <div class="modal fade" id="experienceModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="experienceModalLabel">Проект / Опыт работы</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="modal-exp-id" value="0" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Название проекта / Компания</label>
                            <input type="text" id="modal-exp-company" class="form-control" />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Дата начала</label>
                                <input type="date" id="modal-exp-start" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Дата окончания</label>
                                <input type="date" id="modal-exp-end" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Описание (Markdown)</label>
                            <textarea id="modal-exp-desc" class="form-control" rows="5"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Технологические теги</label>
                            <input type="text" id="modal-exp-tags" class="form-control" placeholder="C#, ASP.NET, PostgreSQL..." />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="button" class="btn btn-primary" id="btn-save-exp-modal">Применить</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const dropZone = document.getElementById("avatarDropZone")
            const input = document.getElementById("avatarInput")
            const previewContainer = document.getElementById("avatarPreviewContainer")
            const preview = document.getElementById("avatarPreview")

            if (!dropZone || !input) {
                return
            }

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ]

            const maxFileSize = 5 * 1024 * 1024

            function handleFile(file) {
                if (!file) {
                    return
                }

                if (!allowedTypes.includes(file.type)) {
                    alert("Разрешены только JPG, PNG и WebP.")
                    input.value = ""
                    return
                }

                if (file.size > maxFileSize) {
                    alert("Размер изображения не должен превышать 5 МБ.")
                    input.value = ""
                    return
                }

                const dataTransfer = new DataTransfer()

                dataTransfer.items.add(file)
                input.files = dataTransfer.files

                const reader = new FileReader()

                reader.onload = function(event) {
                    preview.src = event.target.result
                    previewContainer.classList.remove("d-none")
                }

                reader.readAsDataURL(file)
            }

            input.addEventListener("change", function() {
                handleFile(input.files[0])
            })

            dropZone.addEventListener("dragover", function(event) {
                event.preventDefault()

                dropZone.classList.add("bg-light")
            })

            dropZone.addEventListener("dragleave", function() {
                dropZone.classList.remove("bg-light")
            })

            dropZone.addEventListener("drop", function(event) {
                event.preventDefault()

                dropZone.classList.remove("bg-light")

                const file = event.dataTransfer.files[0]

                handleFile(file)
            })
        })
    </script>

    <script>
        const profileAttributesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProfileAttributes))

        const container = document.getElementById('attributes-container')
        const categorySelect = document.getElementById('category-select')
        const attrSelect = document.getElementById('attribute-select')
        const btnAdd = document.getElementById('btn-confirm-add-attribute')

        const addedAttributeIds = new Set()

        function init() {
            profileAttributesData.forEach(attr => {
                if (attr.Value !== null && attr.Value !== undefined && attr.Value !== "") {
                    renderAttributeUI(attr)
                }
            })
        }

        function renderAttributeUI(attr) {
            const wrapper = document.createElement('div')
            wrapper.className = 'mb-3 d-flex align-items-start gap-3'
            wrapper.id = `attr-wrapper-${attr.AttributeId}`

            const fieldDiv = document.createElement('div')
            fieldDiv.className = 'flex-grow-1'

            const label = document.createElement('label')
            label.className = 'form-label fw-bold'
            label.innerText = attr.Title
            fieldDiv.appendChild(label)

            const inputName = `DynamicAttributes[${attr.AttributeId}]`
            let inputHtml = ''

            if (attr.DataTypeId === 1) {
                inputHtml = `<input type="text" name="${inputName}" class="form-control" value="${attr.Value || ''}" required>`
            } else if (attr.DataTypeId === 2) {
                inputHtml = `<textarea name="${inputName}" class="form-control" rows="3" required>${attr.Value || ''}</textarea>`
            } else if (attr.DataTypeId === 3) {
                inputHtml = `<input type="number" name="${inputName}" class="form-control" value="${attr.Value || ''}" required>`
            } else if (attr.DataTypeId === 4) {
                inputHtml = `<input type="date" name="${inputName}" class="form-control" value="${attr.Value || ''}" required>`
            } else if (attr.DataTypeId === 5) {
                let sVal = '', eVal = ''
                if (attr.Value && attr.Value.includes('/')) {
                    const parts = attr.Value.split('/')
                    sVal = parts[0]
                    eVal = parts[1]
                }
                inputHtml = `
                    <div class="d-flex align-items-center gap-2">
                        <input type="date" class="form-control" value="${sVal}" onchange="updatePeriod(${attr.AttributeId}, this.parentNode)" required>
                        <span>-</span>
                        <input type="date" class="form-control" value="${eVal}" onchange="updatePeriod(${attr.AttributeId}, this.parentNode)" required>
                        <input type="hidden" name="${inputName}" value="${attr.Value || ''}">
                    </div>
                `
            } else if (attr.DataTypeId === 6) {
                const isChecked = attr.Value === 'true' ? 'checked' : ''
                inputHtml = `
                    <div class="form-check form-switch mt-2">
                        <input type="hidden" name="${inputName}" value="false">
                        <input class="form-check-input" type="checkbox" name="${inputName}" value="true" ${isChecked} onchange="this.previousElementSibling.disabled = this.checked">
                        <label class="form-check-label text-muted">Да / Нет</label>
                    </div>
                `
            } else if (attr.DataTypeId === 7) {
                inputHtml = `<select name="${inputName}" class="form-select" required><option value="">-- Выберите --</option>`
                attr.Options.forEach(opt => {
                    const selected = (attr.Value === opt) ? 'selected' : ''
                    inputHtml += `<option value="${opt}" ${selected}>${opt}</option>`
                })
                inputHtml += `</select>`
            }

            fieldDiv.insertAdjacentHTML('beforeend', inputHtml)
            wrapper.appendChild(fieldDiv)

            const removeBtn = document.createElement('button')
            removeBtn.type = 'button'
            removeBtn.className = 'btn-close mt-4'
            removeBtn.setAttribute('aria-label', 'Close')
            removeBtn.onclick = () => removeAttribute(attr.AttributeId)

            wrapper.appendChild(removeBtn)
            container.appendChild(wrapper)

            addedAttributeIds.add(attr.AttributeId)
        }

        window.updatePeriod = function(attrId, parentElement) {
            const dateInputs = parentElement.querySelectorAll('input[type="date"]')
            const hiddenInput = parentElement.querySelector('input[type="hidden"]')
            if (dateInputs[0].value && dateInputs[1].value) {
                hiddenInput.value = `${dateInputs[0].value}/${dateInputs[1].value}`
            } else {
                hiddenInput.value = ''
            }
        }

        function removeAttribute(attrId) {
            document.getElementById(`attr-wrapper-${attrId}`).remove()
            addedAttributeIds.delete(attrId)

            const attr = profileAttributesData.find(a => a.AttributeId === attrId)
            if (attr) attr.Value = null

            updateAttributeOptions()
        }

        categorySelect.addEventListener('change', (e) => {
            const categoryId = parseInt(e.target.value)
            attrSelect.innerHTML = '<option value="">-- Выберите атрибут --</option>'

            if (!categoryId) {
                attrSelect.disabled = true
                btnAdd.disabled = true
                return
            }

            const filtered = profileAttributesData.filter(a => a.CategoryId === categoryId && !addedAttributeIds.has(a.AttributeId))

            filtered.forEach(attr => {
                const option = document.createElement('option')
                option.value = attr.AttributeId
                option.innerText = attr.Title
                attrSelect.appendChild(option)
            })

            attrSelect.disabled = filtered.length === 0
            if (filtered.length === 0) {
                attrSelect.innerHTML = '<option value="">-- Все атрибуты этой категории уже добавлены --</option>'
            }

            btnAdd.disabled = true
        })

        function updateAttributeOptions() {
            categorySelect.value = ""
            attrSelect.innerHTML = '<option value="">-- Сначала выберите категорию --</option>'
            attrSelect.disabled = true
            btnAdd.disabled = true
        }

        attrSelect.addEventListener('change', (e) => {
            btnAdd.disabled = !e.target.value
        })

        btnAdd.addEventListener('click', () => {
            const attrId = parseInt(attrSelect.value)
            const attr = profileAttributesData.find(a => a.AttributeId === attrId)
            if (attr) {
                renderAttributeUI(attr)

                const modalEl = document.getElementById('addAttributeModal')
                const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl)
                modal.hide()

                updateAttributeOptions()
            }
        })

        init()




        let experiencesList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Experiences.Select(e => new
            {
                id = e.Id,
                companyName = e.CompanyName,
                startDate = e.StartDate.ToString("yyyy-MM-dd"),
                endDate = e.EndDate?.ToString("yyyy-MM-dd") ?? "",
                description = e.Description ?? "",
                tags = string.Join(", ", e.Tags)
        })))

        const expModalEl = document.getElementById('experienceModal')
        const expModal = expModalEl ? new bootstrap.Modal(expModalEl) : null
        let tempClientCounter = -1

        function renderExperiencesUI() {
            const listContainer = document.getElementById('experiences-list-container')
            const hiddenContainer = document.getElementById('experiences-hidden-inputs')

            if (!listContainer || !hiddenContainer) return

            listContainer.innerHTML = ''
            hiddenContainer.innerHTML = ''

            if (experiencesList.length === 0) {
                listContainer.innerHTML = '<p class="text-muted">Проекты пока не добавлены.</p>'
                return
            }

            experiencesList.forEach((exp, index) => {
                const tagsHtml = exp.tags ? exp.tags.split(',').map(t => `<span class="badge bg-secondary me-1">${t.trim()}</span>`).join('') : ''
                const dateStr = `${exp.startDate} — ${exp.endDate || 'По настоящее время'}`

                const card = document.createElement('div')
                card.className = 'mb-4 pb-3 border-bottom'
                card.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5>${exp.companyName}</h5>
                            <p class="text-muted mb-2"><i class="bi bi-calendar3"></i> ${dateStr}</p>
                        </div>
                        ${ @Model.CanEdit.ToString().ToLower() ? `
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="editExperience(${exp.id})"><i class="bi bi-pencil"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeExperience(${exp.id})"><i class="bi bi-trash"></i></button>
                            </div>
                        ` : '' }
                    </div>
                    <p style="white-space: pre-wrap;">${exp.description}</p>
                    <div>${tagsHtml}</div>
                `
                listContainer.appendChild(card)

                hiddenContainer.insertAdjacentHTML('beforeend', `
                    <input type="hidden" name="ExperiencesInput[${index}].Id" value="${exp.id > 0 ? exp.id : 0}" />
                    <input type="hidden" name="ExperiencesInput[${index}].CompanyName" value="${exp.companyName}" />
                    <input type="hidden" name="ExperiencesInput[${index}].StartDate" value="${exp.startDate}" />
                    <input type="hidden" name="ExperiencesInput[${index}].EndDate" value="${exp.endDate}" />
                    <input type="hidden" name="ExperiencesInput[${index}].Description" value="${exp.description}" />
                    <input type="hidden" name="ExperiencesInput[${index}].Tags" value="${exp.tags}" />
                `)
            })
        }

        document.getElementById('btn-add-experience')?.addEventListener('click', () => {
            document.getElementById('experienceModalLabel').innerText = 'Добавление проекта'
            document.getElementById('modal-exp-id').value = tempClientCounter--
            document.getElementById('modal-exp-company').value = ''
            document.getElementById('modal-exp-start').value = ''
            document.getElementById('modal-exp-end').value = ''
            document.getElementById('modal-exp-desc').value = ''
            document.getElementById('modal-exp-tags').value = ''
            expModal.show()
        })

        window.editExperience = function(id) {
            const exp = experiencesList.find(e => e.id === id)
            if (!exp) return

            document.getElementById('experienceModalLabel').innerText = 'Редактирование проекта'
            document.getElementById('modal-exp-id').value = exp.id
            document.getElementById('modal-exp-company').value = exp.companyName
            document.getElementById('modal-exp-start').value = exp.startDate
            document.getElementById('modal-exp-end').value = exp.endDate
            document.getElementById('modal-exp-desc').value = exp.description
            document.getElementById('modal-exp-tags').value = exp.tags
            expModal.show()
        }

        window.removeExperience = function(id) {
            experiencesList = experiencesList.filter(e => e.id !== id)
            renderExperiencesUI()
        }

        document.getElementById('btn-save-exp-modal')?.addEventListener('click', () => {
            const id = parseInt(document.getElementById('modal-exp-id').value)
            const company = document.getElementById('modal-exp-company').value.trim()
            const start = document.getElementById('modal-exp-start').value

            if (!company || !start) {
                alert('Пожалуйста, заполните название проекта и дату начала.')
                return
            }

            const expData = {
                id: id,
                companyName: company,
                startDate: start,
                endDate: document.getElementById('modal-exp-end').value,
                description: document.getElementById('modal-exp-desc').value,
                tags: document.getElementById('modal-exp-tags').value
            }

            const existingIndex = experiencesList.findIndex(e => e.id === id)
            if (existingIndex >= 0) {
                experiencesList[existingIndex] = expData
            } else {
                experiencesList.push(expData)
            }

            renderExperiencesUI()
            expModal.hide()
        })

        renderExperiencesUI()
    </script>
}