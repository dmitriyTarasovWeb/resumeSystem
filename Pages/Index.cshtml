@page
@model resumeSystem.Pages.IndexModel

@{
    ViewData["Title"] = "Вакансии";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                Вакансии
            </h1>

            <p class="text-body-secondary mb-0">
                Все доступные вакансии
            </p>
        </div>

        @if (User.IsInRole("Recruiter") ||
             User.IsInRole("Administrator"))
        {
            <a asp-page="/Vacancies/Create"
               class="btn btn-primary">
                Создать вакансию
            </a>
        }

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table id="vacancies-table"
                       class="table table-striped table-hover align-middle w-100"
                       style="table-layout: fixed;">


                    <thead>
                        <tr>
                            <th class="text-start">
                                Вакансия
                            </th>

                            <th class="text-start">
                                Должность
                            </th>

                            <th class="text-start">
                                Дата публикации
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var vacancy in Model.Vacancies)
                        {
                            <tr data-url="@Url.Page("/Vacancies/Details", new { id = vacancy.Id })"
                                style="cursor: pointer;">

                                <td class="text-start fw-semibold">
                                    @vacancy.Title
                                </td>

                                <td class="text-start">
                                    @vacancy.PositionName
                                </td>

                                <td class="text-start">
                                    @(vacancy.DisplayDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const table = document.getElementById("vacancies-table")

            if (!table) {
                return
            }

            new DataTable(table, {
                autoWidth: false,
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, "Все"]
                ],

                order: [[2, "desc"]],

            })


            const tbody = table.querySelector("tbody")

            if (!tbody) {
                return
            }

            tbody.addEventListener("click", function (event) {

                const row = event.target.closest("tr")

                if (!row) {
                    return
                }

                const url = row.dataset.url

                if (url) {
                    window.location.href = url
                }

            })

        })
    </script>

}