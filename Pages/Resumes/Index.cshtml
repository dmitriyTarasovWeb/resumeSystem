@page "/Resumes"
@model resumeSystem.Pages.Resumes.IndexModel

@{
    ViewData["Title"] = "Банк резюме";
}

<div class="container py-4 pb-5">

    <div class="border rounded bg-white">

        <div class="border-bottom px-3 px-md-4 py-3">
            <h1 class="h5 mb-0 fw-semibold">
                Резюме
            </h1>
        </div>

        <div class="p-3 p-md-4">

            <div class="table-responsive">

                <table id="resumes-table"
                       class="table table-striped table-hover align-middle w-100"
                       style="table-layout: fixed;">

                    <thead>
                        <tr>
                            <th class="text-start">Кандидат</th>
                            <th class="text-start">Должность</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var resume in Model.Resumes)
                        {
                            <tr data-url="@Url.Page(
                                "/Profile/Profile",
                                "Resume",
                                new
                                {
                                    id = resume.UserId,
                                    resumeId = resume.Id
                                })"
                                style="cursor: pointer;">

                                <td class="text-start fw-semibold">
                                    @resume.FirstName @resume.LastName
                                </td>

                                <td class="text-start">
                                    @resume.PositionName
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const table = document.getElementById("resumes-table")

            if (!table) {
                return
            }

            new DataTable(table, {
                autoWidth: false,
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, "Все"]
                ],

                order: [[1, "asc"]]
            })

            const tbody = table.querySelector("tbody")

            if (!tbody) {
                return
            }

            tbody.addEventListener("click", function (event) {

                const row = event.target.closest("tr")

                if (!row) {
                    return
                }

                const url = row.dataset.url

                if (url) {
                    window.location.href = url
                }

            })

        })
    </script>
}