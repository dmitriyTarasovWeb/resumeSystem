@page "/Resumes/Create/{vacancyId:guid}"
@model resumeSystem.Pages.Resumes.CreateModel

@{
    ViewData["Title"] = "Формирование резюме";
}

<div class="container py-4 pb-5">

    <div class="mb-4">

        <h1 class="h2 mb-2">
            Формирование резюме
        </h1>

        <div class="fs-5 text-body-secondary">
            @Model.Vacancy.Title
        </div>

        <div class="text-body-secondary">
            @Model.Vacancy.PositionName
        </div>

    </div>


    <section class="border rounded bg-white mb-4">

        <div class="border-bottom px-3 px-md-4 py-3">

            <h2 class="h6 mb-0 fw-semibold">
                Основная информация
            </h2>

        </div>


        <div class="p-3 p-md-4">

            @if (!string.IsNullOrWhiteSpace(Model.RequiredAttributes.PhotoUrl))
            {
                <div class="mb-4">

                    <img src="@Model.RequiredAttributes.PhotoUrl"
                         alt="Фото профиля"
                         class="rounded-circle border"
                         width="120"
                         height="120"
                         style="object-fit: cover;" />

                </div>
            }


            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label fw-medium">
                        Имя
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.RequiredAttributes.FirstName"
                           required />

                </div>


                <div class="col-md-6">

                    <label class="form-label fw-medium">
                        Фамилия
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.RequiredAttributes.LastName"
                           required />

                </div>


                <div class="col-md-6">

                    <label class="form-label fw-medium">
                        Возраст
                    </label>

                    <input type="number"
                           class="form-control"
                           value="@Model.RequiredAttributes.Age"
                           required />

                </div>


                <div class="col-md-6">

                    <label class="form-label fw-medium">
                        Местоположение
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.RequiredAttributes.Location"
                           required />

                </div>

            </div>


            <div class="mt-3">

                <label class="form-label fw-medium">
                    О себе
                </label>

                <textarea class="form-control"
                          rows="5"
                          required>@Model.RequiredAttributes.Description</textarea>

            </div>

        </div>

    </section>


    <section class="border rounded bg-white mb-4">

        <div class="border-bottom px-3 px-md-4 py-3">

            <h2 class="h6 mb-0 fw-semibold">
                Атрибуты вакансии
            </h2>

        </div>


        <div class="p-3 p-md-4">

            @if (Model.Attributes.Count == 0)
            {
                <div class="text-body-secondary">
                    В вакансии нет дополнительных атрибутов.
                </div>
            }
            else
            {
                @foreach (var attr in Model.Attributes)
                {
                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            @attr.Title
                        </label>


                        @switch (attr.DataTypeId)
                        {
                            case 1:
                                <input type="text"
                                       name="DynamicAttributes[@attr.AttributeId]"
                                       class="form-control"
                                       value="@attr.Value"
                                       required />
                                break;


                            case 2:
                                <textarea name="DynamicAttributes[@attr.AttributeId]"
                                          class="form-control"
                                          rows="4"
                                          required>@attr.Value</textarea>
                                break;


                            case 3:
                                <input type="number"
                                       step="any"
                                       name="DynamicAttributes[@attr.AttributeId]"
                                       class="form-control"
                                       value="@attr.Value"
                                       required />
                                break;


                            case 4:
                                <input type="date"
                                       name="DynamicAttributes[@attr.AttributeId]"
                                       class="form-control"
                                       value="@attr.Value"
                                       required />
                                break;


                            case 5:
                                var periodParts = (attr.Value ?? "")
                                    .Split('/', StringSplitOptions.None);

                                <div class="d-flex align-items-center gap-2">

                                    <input type="date"
                                           class="form-control"
                                           value="@(periodParts.Length > 0 ? periodParts[0] : "")"
                                           required />

                                    <span>-</span>

                                    <input type="date"
                                           class="form-control"
                                           value="@(periodParts.Length > 1 ? periodParts[1] : "")"
                                           required />

                                </div>

                                break;


                            case 6:

                                <div class="form-check form-switch">

                                    <input type="checkbox"
                                           class="form-check-input"
                                           name="DynamicAttributes[@attr.AttributeId]"
                                           value="true"
                                           @(attr.Value == "true" ? "checked" : null) />

                                    <label class="form-check-label">
                                        Да / Нет
                                    </label>

                                </div>

                                break;


                            case 7:

                                <select name="DynamicAttributes[@attr.AttributeId]"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        -- Выберите --
                                    </option>

                                    @foreach (var option in attr.Options)
                                    {
                                        <option value="@option"
                                                selected="@(attr.Value == option)">
                                            @option
                                        </option>
                                    }

                                </select>

                                break;
                        }

                    </div>
                }
            }

        </div>

    </section>



    <section class="border rounded bg-white mb-4">

    <div class="border-bottom px-3 px-md-4 py-3">
        <h2 class="h6 mb-0 fw-semibold">
            Проекты
        </h2>
    </div>

    <div class="p-3 p-md-4">

        @if (Model.Experiences.Count == 0)
        {
            <p class="text-muted mb-0">
                В профиле пока нет проектов.
            </p>
        }
        else
        {
            <div class="d-flex flex-column gap-3">

                @foreach (var experience in Model.Experiences)
                {
                    <div class="border rounded p-3">

                        <div class="form-check mb-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="SelectedExperienceIds"
                                   value="@experience.Id"
                                   id="experience-@experience.Id" />

                            <label class="form-check-label fw-semibold"
                                   for="experience-@experience.Id">
                                @experience.CompanyName
                            </label>
                        </div>

                        <div class="text-muted small mb-2">
                            @experience.StartDate.ToString("dd.MM.yyyy")
                            —
                            @(experience.EndDate?.ToString("dd.MM.yyyy") ?? "По настоящее время")
                        </div>

                        @if (!string.IsNullOrWhiteSpace(experience.Description))
                        {
                            <div class="small">
                                @experience.Description
                            </div>
                        }

                        @if (experience.Tags.Count > 0)
                        {
                            <div class="mt-2">
                                @foreach (var tag in experience.Tags)
                                {
                                    <span class="badge bg-secondary me-1">
                                        @tag
                                    </span>
                                }
                            </div>
                        }

                    </div>
                }

            </div>
        }

    </div>

</section>


    <div class="d-flex justify-content-between pt-2">

        <a asp-page="/Vacancies/Details"
           asp-route-id="@Model.Vacancy.Id"
           class="btn btn-outline-secondary">
            Назад
        </a>


        <button type="button"
                class="btn btn-primary">
            Сохранить резюме
        </button>

    </div>

</div>