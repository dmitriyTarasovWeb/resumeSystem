@page "/Resumes/Create/{vacancyId:guid}"
@model resumeSystem.Pages.Resumes.CreateModel

@{
    ViewData["Title"] = "Формирование резюме";
}

<form method="post">
    <input type="hidden"
           name="vacancyId"
           value="@Model.Vacancy.Id" />

<div class="container py-4 pb-5">

    <div class="mb-4">

        <h1 class="h2 mb-2">
            Формирование резюме
        </h1>

        <div class="fs-5 text-body-secondary">
            @Model.Vacancy.Title
        </div>

        <div class="text-body-secondary">
            @Model.Vacancy.PositionName
        </div>

    </div>


    <section class="border rounded bg-white mb-4">

        <div class="border-bottom px-3 px-md-4 py-3 d-flex justify-content-between align-items-center">

            <h2 class="h6 mb-0 fw-semibold">
                Основная информация
            </h2>

            <a asp-page="/Profile/Profile"
               asp-route-id="@Model.ResumeUserId"
               class="btn btn-outline-primary">
                Перейти в профиль
            </a>

        </div>




        <div class="p-3 p-md-4">

            @if (!string.IsNullOrWhiteSpace(Model.RequiredAttributes.PhotoUrl))
            {
                <div class="mb-4">

                    <img src="@Model.RequiredAttributes.PhotoUrl"
                         alt="Фото профиля"
                         class="rounded-circle border"
                         width="120"
                         height="120"
                         style="object-fit: cover;" />

                </div>
            }


            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label fw-medium">
                        Имя
                    </label>

                    <input type="text"
                       name="RequiredAttributes.FirstName"
                       class="form-control"
                       value="@Model.RequiredAttributes.FirstName"
                       @(Model.CanEdit ? null : "readonly")
                       required />

                </div>


                <div class="col-md-6">

                    <label class="form-label fw-medium">
                        Фамилия
                    </label>

                    <input type="text"
                       name="RequiredAttributes.LastName"
                       class="form-control"
                       value="@Model.RequiredAttributes.LastName"
                       @(Model.CanEdit ? null : "readonly")
                       required />

                </div>


                <div class="col-md-6">

                    <label class="form-label fw-medium">
                        Возраст
                    </label>

                    <input type="number"
                       name="RequiredAttributes.Age"
                       class="form-control"
                       value="@Model.RequiredAttributes.Age"
                       @(Model.CanEdit ? null : "readonly")
                       required />

                </div>


                <div class="col-md-6">

                    <label class="form-label fw-medium">
                        Местоположение
                    </label>

                    <input type="text"
                       name="RequiredAttributes.Location"
                       class="form-control"
                       value="@Model.RequiredAttributes.Location"
                       @(Model.CanEdit ? null : "readonly")
                       required />

                </div>

            </div>


            <div class="mt-3">

                <label class="form-label fw-medium">
                    О себе
                </label>

                <div class="form-control bg-light">
                    @Html.Raw(
                        Markdig.Markdown.ToHtml(
                            Model.RequiredAttributes.Description ?? string.Empty
                        )
                    )
                </div>

            </div>

        </div>

    </section>


    <section class="border rounded bg-white mb-4">

        <div class="border-bottom px-3 px-md-4 py-3">

            <h2 class="h6 mb-0 fw-semibold">
                Атрибуты вакансии
            </h2>

        </div>


        <div class="p-3 p-md-4">

            @if (Model.Attributes.Count == 0)
            {
                <div class="text-body-secondary">
                    В вакансии нет дополнительных атрибутов.
                </div>
            }
            else
            {
                @foreach (var attr in Model.Attributes)
                {
                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            @attr.Title
                        </label>


                        @switch (attr.DataTypeId)
                        {
                            case 1:
                                <input type="text"
                                       name="DynamicAttributes[@attr.AttributeId]"
                                       class="form-control"
                                       value="@attr.Value"
                                       @(Model.CanEdit ? null : "readonly")
                                       required />
                                break;


                            case 2:
                                <textarea name="DynamicAttributes[@attr.AttributeId]"
                                          class="form-control"
                                          rows="4"
                                          @(Model.CanEdit ? null : "readonly")
                                          required>@attr.Value</textarea>
                                break;


                            case 3:
                                <input type="number"
                                       step="any"
                                       name="DynamicAttributes[@attr.AttributeId]"
                                       class="form-control"
                                       value="@attr.Value"
                                       @(Model.CanEdit ? null : "readonly")
                                       required />
                                break;


                            case 4:
                                <input type="date"
                                       name="DynamicAttributes[@attr.AttributeId]"
                                       class="form-control"
                                       value="@attr.Value"
                                       @(Model.CanEdit ? null : "readonly")
                                       required />
                                break;


                            case 5:
                                var periodParts = (attr.Value ?? "")
                                    .Split('/', StringSplitOptions.None);

                                <div class="d-flex align-items-center gap-2"
                                     data-period-container="@attr.AttributeId">

                                    <input type="hidden"
                                           name="DynamicAttributes[@attr.AttributeId]"
                                           value="@attr.Value" />

                                    <input type="date"
                                       class="form-control"
                                       value="@(periodParts.Length > 0 ? periodParts[0] : "")"
                                       @(Model.CanEdit ? null : "readonly")
                                       data-period-start
                                       required />

                                    <span>-</span>

                                    <input type="date"
                                           class="form-control"
                                           value="@(periodParts.Length > 1 ? periodParts[1] : "")"
                                           @(Model.CanEdit ? null : "readonly")
                                           data-period-end
                                           required />

                                </div>

                                break;


                            case 6:

                                <div class="form-check form-switch">

                                    <input type="hidden"
                                           name="DynamicAttributes[@attr.AttributeId]"
                                           value="false" />

                                    <input type="checkbox"
                                       class="form-check-input"
                                       name="DynamicAttributes[@attr.AttributeId]"
                                       value="true"
                                       @(attr.Value == "true" ? "checked" : null)
                                       @(Model.CanEdit ? null : "disabled") />

                                    <label class="form-check-label">
                                        Нет / Да
                                    </label>

                                </div>

                                break;


                            case 7:

                                <select name="DynamicAttributes[@attr.AttributeId]"
                                    class="form-select"
                                    @(Model.CanEdit ? null : "disabled")
                                    required>

                                    <option value="">
                                        -- Выберите --
                                    </option>

                                    @foreach (var option in attr.Options)
                                    {
                                        <option value="@option"
                                                selected="@(attr.Value == option)">
                                            @option
                                        </option>
                                    }

                                </select>

                                break;
                        }

                    </div>
                }
            }

        </div>

    </section>



    <section class="border rounded bg-white mb-4">

        <div class="border-bottom px-3 px-md-4 py-3">
            <h2 class="h6 mb-0 fw-semibold">
                Проекты
            </h2>
        </div>

        <div class="p-3 p-md-4">

            @if (Model.Experiences.Count == 0)
            {
                <p class="text-muted mb-0">
                    Подходящих проектов по тегам вакансии не найдено.
                </p>
            }
            else
            {
                <div class="d-flex flex-column gap-3">

                    @foreach (var experience in Model.Experiences)
                    {
                        <article class="border rounded p-3">

                            <div class="d-flex justify-content-between align-items-start gap-3 mb-2">

                                <div>
                                    <h3 class="h6 mb-1">
                                        @experience.CompanyName
                                    </h3>

                                    <div class="text-muted small">
                                        @experience.StartDate.ToString("dd.MM.yyyy")
                                        —
                                        @(experience.EndDate?.ToString("dd.MM.yyyy")
                                            ?? "По настоящее время")
                                    </div>
                                </div>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(experience.Description))
                            {
                                <div class="form-control bg-light">
                                    @Html.Raw(
                                        Markdig.Markdown.ToHtml(
                                            experience.Description ?? string.Empty
                                        )
                                    )
                                </div>
                            }

                            @if (experience.Tags.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1">

                                    @foreach (var tag in experience.Tags)
                                    {
                                        <span class="badge bg-secondary">
                                            @tag
                                        </span>
                                    }

                                </div>
                            }

                        </article>
                    }

                </div>
            }

        </div>

    </section>


    <div class="d-flex justify-content-between pt-2">

        <a asp-page="/Vacancies/Details"
           asp-route-id="@Model.Vacancy.Id"
           class="btn btn-outline-secondary">
            Назад
        </a>


        @if (Model.CanEdit)
        {
            <button type="submit" class="btn btn-primary">
                Сохранить резюме
            </button>
        }

    </div>

</div>
</div>





    <script>
        document.querySelectorAll("[data-period-container]").forEach(container => {
            const startInput = container.querySelector("[data-period-start]")
            const endInput = container.querySelector("[data-period-end]")
            const hiddenInput = container.querySelector('input[type="hidden"]')

            function updatePeriod() {
                if (!startInput.value || !endInput.value) {
                    hiddenInput.value = ""
                    return
                }

                hiddenInput.value = `${startInput.value}/${endInput.value}`
            }

            startInput.addEventListener("change", updatePeriod)
            endInput.addEventListener("change", updatePeriod)
        })

        document.querySelector("form").addEventListener("submit", () => {
            document.querySelectorAll("[data-period-container]").forEach(container => {
                const startInput = container.querySelector("[data-period-start]")
                const endInput = container.querySelector("[data-period-end]")
                const hiddenInput = container.querySelector('input[type="hidden"]')

                if (startInput.value && endInput.value) {
                    hiddenInput.value = `${startInput.value}/${endInput.value}`
                } else {
                    hiddenInput.value = ""
                }
            })
        })
    </script>
</form>